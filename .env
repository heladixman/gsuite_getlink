# =========================================================
# CapCut Automation Configuration
# =========================================================

# Jumlah maksimal browser yang diproses secara bersamaan (Paralel / Concurrency)
# Contoh: 1 = Satu per satu (disarankan & paling stabil)
#         2 = Dua browser sekaligus
#         3 = Tiga browser sekaligus
MAX_THREADS=3

# Jeda waktu pendinginan (Cooling Process) antar akun (dalam satuan DETIK)
# Contoh: 5 = Jeda 5 detik sebelum akun berikutnya diproses
#         10 = Jeda 10 detik
DELAY_BETWEEN_ACCOUNTS=30

# Batas maksimal latency proxy dalam milidetik (ms) untuk kategori High Speed
# Browser hanya akan menggunakan node proxy yang lolos pengujian kecepatan ini
MAX_PROXY_LATENCY_MS=2500

# Port Server Dashboard Web
PORT=5000
